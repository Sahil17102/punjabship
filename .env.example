# Public frontend build variables
API_BASE_URL=https://PunjabShip-logisticbackend.onrender.com
BACKEND_URL=https://PunjabShip-logisticbackend.onrender.com
FRONTEND_URL=https://PunjabShip-logistic.onrender.com

# Backend service only. Never expose this value in a frontend build.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# ShipGlobal Vendor API (backend only; add real production credentials as Render secrets)
SHIPGLOBAL_API_BASE_URL=https://app.shipglobal.in/apiv1
SHIPGLOBAL_USERNAME=your-production-vendor-email
SHIPGLOBAL_PASSWORD=your-production-vendor-password
SHIPGLOBAL_SERVICE=Shipglobal Direct
SHIPGLOBAL_CURRENCY=INR
SHIPGLOBAL_TIMEOUT_MS=60000

# SME Courier FedEx Direct API (backend only; use Render/server secrets)
SMECOURIER_API_BASE_URL=https://portal.smecourier.in
SMECOURIER_USERNAME=your-sme-api-username
SMECOURIER_PASSWORD=your-sme-api-password
SMECOURIER_SERVICE_CODE=INTERNATIONAL PRIORITY
SMECOURIER_SHIPMENT_TYPE=NDox
SMECOURIER_DOC_TYPE=GSTIN
SMECOURIER_DOC_VALUE=your-consignor-document-number
# Optional SME Courier master IDs, if your account requires them
SMECOURIER_FEDEX_ACCOUNT_ID=
SMECOURIER_PACKAGE_ID=
SMECOURIER_TIMEOUT_MS=60000

# Outbound email (backend only). Keep SMTP_PASSWORD in server secrets, never Git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
MAIL_FROM_NAME=PunjabShip
MAIL_FROM_ADDRESS=your-sender@gmail.com

# Cloudflare R2 (backend only). R2_ENDPOINT must be the account endpoint;
# objects are isolated beneath R2_PREFIX inside R2_BUCKET.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-production-bucket
R2_PREFIX=punjabship
