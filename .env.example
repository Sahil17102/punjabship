# Public frontend build variables
API_BASE_URL=https://PunjabShip-logisticbackend.onrender.com
BACKEND_URL=https://PunjabShip-logisticbackend.onrender.com
FRONTEND_URL=https://PunjabShip-logistic.onrender.com

# Backend service only. Never expose this value in a frontend build.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# ShipGlobal Vendor API (backend only; add real production credentials as Render secrets)
SHIPGLOBAL_API_BASE_URL=https://app.shipglobal.in/apiv1
SHIPGLOBAL_USERNAME=your-production-vendor-email
SHIPGLOBAL_PASSWORD=your-production-vendor-password
SHIPGLOBAL_SERVICE=Shipglobal Direct
SHIPGLOBAL_CURRENCY=INR
SHIPGLOBAL_TIMEOUT_MS=60000
